meta {
  name: 02 - Login gerente (Keycloak)
  type: http
  seq: 2
}

post {
  url: {{keycloakUrl}}/realms/{{realm}}/protocol/openid-connect/token
  body: formUrlEncoded
  auth: none
}

body:form-urlencoded {
  grant_type: password
  client_id: {{clientId}}
  username: {{gerenteUser}}
  password: {{gerentePassword}}
}

assert {
  res.status: eq 200
}

script:post-response {
  // Guarda o access_token para as próximas requisições usarem {{gerenteToken}}
  bru.setEnvVar("gerenteToken", res.body.access_token);
}
