# Copie este arquivo para ".env" e ajuste os valores.
# O arquivo ".env" NÃO deve ir para o Git (já está no .gitignore).

# Endereço do realm no Keycloak. Precisa ser IGUAL ao campo "iss" dos tokens.
KEYCLOAK_ISSUER=http://localhost:8080/realms/empresa

# Porta da API
PORT=3000

# URL de conexão do Postgres do Supabase (contém a SENHA do banco: nunca vá para o Git).
# Copie a sua no painel do Supabase: botão "Connect" > "Session pooler".
# Formato: postgresql://postgres.<ref-do-projeto>:<SENHA>@<host-do-pooler>:5432/postgres
DATABASE_URL=

# Usado apenas pelo docker-compose para a senha do admin do Keycloak.
# Defina a sua (não use uma senha que você usa em outros lugares).
KEYCLOAK_ADMIN_PASSWORD=
